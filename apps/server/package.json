{
  "name": "@stockflow/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json -f -fe .js",
    "start": "node dist/index.js",
    "db:cli": "node scripts/typeorm-cli.mjs",
    "db:migrate": "node scripts/typeorm-cli.mjs migration:run -d src/database/data-source.ts",
    "db:migrate:revert": "node scripts/typeorm-cli.mjs migration:revert -d src/database/data-source.ts",
    "db:migrate:generate": "node scripts/typeorm-cli.mjs migration:generate -d src/database/data-source.ts",
    "db:show": "node scripts/typeorm-cli.mjs migration:show -d src/database/data-source.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:drop": "node scripts/typeorm-cli.mjs schema:drop -d src/database/data-source.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^10.1.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^8.1.1",
    "@fastify/sensible": "^5.6.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^2.1.0",
    "@stockflow/config": "workspace:*",
    "@stockflow/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^4.27.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rotating-file-stream": "^3.2.9",
    "typeorm": "^1.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@stockflow/eslint-config": "workspace:*",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.0",
    "eslint": "^10.8.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}

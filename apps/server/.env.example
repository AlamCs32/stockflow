# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=true

# Uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE=5242880

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=stockflow
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
DB_LOGGING=false

# Inventory
INVENTORY_LOW_STOCK_THRESHOLD=5

# Swagger
SWAGGER_ENABLED=true
SWAGGER_ROUTE_PREFIX=/docs

# Logging (Pino)
LOG_LEVEL=debug
LOG_DIR=./logs
LOG_MAX_FILE_SIZE=10M
LOG_MAX_FILES=14
LOG_PRETTY_PRINT=true
